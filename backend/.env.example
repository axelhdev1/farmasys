# Copia este archivo como ".env" y completa los valores reales.

# Conexión a PostgreSQL local (ajusta usuario, contraseña y nombre de BD)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/farmasys?schema=public"

# ── JWT ────────────────────────────────────────────────────────────────
# Secretos para firmar los tokens. USA cadenas largas, aleatorias y DISTINTAS.
# Genera p.ej. con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="cambia-esto-access-clave-larga-y-secreta"
JWT_REFRESH_SECRET="cambia-esto-refresh-otra-clave-larga-y-secreta"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Costo de bcrypt (rounds). 10–12 recomendado.
BCRYPT_ROUNDS=10

# ── Seed admin inicial (usado por db:seed) ─────────────────────────────
SEED_ADMIN_EMAIL="admin@farmasys.pe"
SEED_ADMIN_PASSWORD="DEFINE-UNA-CLAVE-FUERTE"

# ── Redis (caché de catálogo + colas BullMQ para SUNAT/emails) ─────────
REDIS_URL="redis://localhost:6379"

# ── SUNAT / PSE (comprobante electrónico) ──────────────────────────────
# Proveedor: "stub" (local) | "nubefact" | "bizlinks"
PSE_PROVIDER="stub"
PSE_API_URL=""
PSE_API_TOKEN=""
RUC_EMISOR="20123456789"

# Puerto del API
PORT=3000

# Origen permitido (tu frontend Angular en desarrollo)
CORS_ORIGIN="http://localhost:4200"

# ─────────────────────────── PRODUCCIÓN ───────────────────────────
# En producción, PONER production. Con este valor el backend ABORTA el arranque
# si los secretos JWT faltan o son los de desarrollo (ver src/main.ts).
# Dejarlo en "development" en un servidor real desactiva esa protección.
NODE_ENV=development
